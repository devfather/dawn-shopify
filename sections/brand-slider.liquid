{{ 'section-brand-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    --brand-slider-logo-height: {{ section.settings.logo_height }}px;
    --brand-slider-gap: {{ section.settings.logo_spacing }}px;
    --brand-slider-speed: {{ section.settings.scroll_speed }}s;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="brand-slider color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {%- unless section.settings.title == blank -%}
      <div class="page-width">
        <div class="title-wrapper title-wrapper--no-top-margin{% if section.settings.heading_alignment == 'center' %} center{% endif %}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="brand-slider__track-wrapper"
        role="region"
        aria-label="{% if section.settings.title != blank %}{{ section.settings.title | strip_html | escape }}{% else %}{{ 'sections.brand_slider.carousel' | t }}{% endif %}"
      >
        <div class="brand-slider__track brand-slider__track--{{ section.settings.scroll_direction }}{% if section.settings.pause_on_hover %} brand-slider__track--pause-on-hover{% endif %}">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- liquid
                if block.settings.brand_name != blank
                  assign brand_alt = block.settings.brand_name
                elsif block.settings.image.alt != blank
                  assign brand_alt = block.settings.image.alt
                else
                  assign brand_alt = 'sections.brand_slider.brand_logo' | t
                endif
              -%}
              <div
                class="brand-slider__item{% if i == 2 %} brand-slider__track-duplicate{% endif %}"
                {% if i == 2 %}
                  aria-hidden="true"
                {% endif %}
                {% if i == 1 %}
                  {{ block.shopify_attributes }}
                {% endif %}
              >
                {%- if block.settings.link != blank and i == 1 -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="brand-slider__link"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank"
                      rel="noopener noreferrer"
                    {% endif %}
                  >
                {%- elsif block.settings.link != blank -%}
                  <span class="brand-slider__link">
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'brand-slider__image',
                      widths: '150, 200, 300, 400, 600',
                      sizes: '160px',
                      alt: brand_alt
                  }}
                {%- else -%}
                  <div class="brand-slider__placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}

                {%- if block.settings.link != blank and i == 1 -%}
                  </a>
                {%- elsif block.settings.link != blank -%}
                  </span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.brand-slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.brand-slider.settings.title.default",
      "label": "t:sections.brand-slider.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.brand-slider.settings.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.brand-slider.settings.heading_alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.brand-slider.settings.heading_alignment.label"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.brand-slider.settings.logo_height.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.brand-slider.settings.logo_spacing.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "t:sections.brand-slider.settings.scroll_speed.label",
      "info": "t:sections.brand-slider.settings.scroll_speed.info",
      "default": 30
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "options": [
        {
          "value": "left",
          "label": "t:sections.brand-slider.settings.scroll_direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.brand-slider.settings.scroll_direction.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.brand-slider.settings.scroll_direction.label"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "t:sections.brand-slider.settings.pause_on_hover.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.brand-slider.blocks.brand.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.brand-slider.blocks.brand.settings.image.label"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "t:sections.brand-slider.blocks.brand.settings.brand_name.label",
          "info": "t:sections.brand-slider.blocks.brand.settings.brand_name.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.brand-slider.blocks.brand.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "default": false,
          "label": "t:sections.brand-slider.blocks.brand.settings.open_in_new_tab.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brand-slider.presets.name",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
