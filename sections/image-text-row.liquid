{{ 'section-image-text-row.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    --image-text-row-desktop-image: {% if section.settings.desktop_image_width == 'small' %}33.333{% elsif section.settings.desktop_image_width == 'large' %}50{% else %}40{% endif %}%;
    --image-text-row-mobile-opacity: {{ section.settings.mobile_image_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="image-text-row color-{{ section.settings.section_color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="image-text-row__inner image-text-row__inner--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-text-row__media" aria-hidden="{% if section.settings.image == blank %}true{% else %}false{% endif %}">
        {%- if section.settings.image != blank -%}
          {%- liquid
            if section.settings.image_alt != blank
              assign row_image_alt = section.settings.image_alt
            elsif section.settings.image.alt != blank
              assign row_image_alt = section.settings.image.alt
            else
              assign row_image_alt = 'sections.image_text_row.image' | t
            endif
          -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              widths: '165, 360, 535, 750, 900, 1200, 1500',
              sizes: '(min-width: 750px) 40vw, 100vw',
              class: 'image-text-row__image',
              fetchpriority: fetch_priority,
              alt: row_image_alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'image-text-row__placeholder' }}
        {%- endif -%}
      </div>

      <div class="image-text-row__content image-text-row__content--{{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="image-text-row__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div class="image-text-row__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  {% if block.settings.button_link == blank %}
                    role="link"
                    aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-text-row.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-text-row.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.image-text-row.settings.image_alt.label",
      "info": "t:sections.image-text-row.settings.image_alt.info"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image-first",
          "label": "t:sections.image-text-row.settings.layout.options__1.label"
        },
        {
          "value": "text-first",
          "label": "t:sections.image-text-row.settings.layout.options__2.label"
        }
      ],
      "default": "image-first",
      "label": "t:sections.image-text-row.settings.layout.label",
      "info": "t:sections.image-text-row.settings.layout.info"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-text-row.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-text-row.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-text-row.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "small",
      "label": "t:sections.image-text-row.settings.desktop_image_width.label",
      "info": "t:sections.image-text-row.settings.desktop_image_width.info"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-text-row.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-text-row.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-text-row.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-text-row.settings.content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-text-row.settings.header_mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.image-text-row.settings.mobile_image_opacity.label",
      "info": "t:sections.image-text-row.settings.mobile_image_opacity.info",
      "default": 25
    },
    {
      "type": "header",
      "content": "t:sections.image-text-row.settings.header_colors.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.image-text-row.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-text-row.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.image-text-row.blocks.heading.settings.heading.default",
          "label": "t:sections.image-text-row.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-text-row.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.image-text-row.blocks.text.settings.text.default",
          "label": "t:sections.image-text-row.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.image-text-row.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.image-text-row.blocks.text.settings.text_style.options__2.label"
            }
          ],
          "default": "body",
          "label": "t:sections.image-text-row.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.image-text-row.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.image-text-row.blocks.button.settings.button_label.default",
          "label": "t:sections.image-text-row.blocks.button.settings.button_label.label",
          "info": "t:sections.image-text-row.blocks.button.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.image-text-row.blocks.button.settings.button_link.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "t:sections.image-text-row.blocks.button.settings.outline_button.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-text-row.presets.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
