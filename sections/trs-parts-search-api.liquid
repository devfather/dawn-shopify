{% comment %}
  JSON search endpoint rendered via Section Rendering API:
  /search?q=QUERY&type=product&sections=trs-parts-search-api

  Exact lookups first (metaobjects):
  - part_number  (OEM + cross-reference)
  - model_number (appliance models)

  Native Shopify product search is only used as a fallback when no exact
  metaobject matches are found (avoids unrelated fuzzy title hits).
{% endcomment %}

{%- liquid
  assign raw_q = search.terms | default: '' | strip
  assign q_handle = raw_q | handleize
  assign max_results = 12
  assign results_count = 0
  assign exact_count = 0
-%}

{%- capture results_json -%}
[
{%- assign first_item = true -%}
{%- assign seen_ids = '' -%}

{%- if q_handle != blank -%}
  {%- assign part_entry = shop.metaobjects.part_number[q_handle] -%}
  {%- if part_entry == blank -%}
    {%- assign q_handle_alt = raw_q | strip | downcase | replace: ' ', '-' | replace: '/', '-' | replace: '_', '-' -%}
    {%- assign part_entry = shop.metaobjects.part_number[q_handle_alt] -%}
  {%- endif -%}

  {%- if part_entry != blank -%}
    {%- assign part_products = part_entry.products.value -%}
    {%- if part_products != blank -%}
      {%- for product in part_products -%}
        {%- if results_count >= max_results -%}{%- break -%}{%- endif -%}
        {%- assign pid = product.id | append: '' -%}
        {%- if seen_ids contains pid -%}{%- continue -%}{%- endif -%}
        {%- assign seen_ids = seen_ids | append: pid | append: ',' -%}
        {%- unless first_item -%},{%- endunless -%}
        {%- assign first_item = false -%}
        {%- assign results_count = results_count | plus: 1 -%}
        {%- assign exact_count = exact_count | plus: 1 -%}
        {
          "group": "Part / cross-reference",
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "meta": {{ part_entry.part.value | default: raw_q | prepend: 'Part ' | json }},
          "image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 120 | json }}{% else %}null{% endif %}
        }
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign model_entry = shop.metaobjects.model_number[q_handle] -%}
  {%- if model_entry == blank -%}
    {%- assign q_handle_alt = raw_q | strip | downcase | replace: ' ', '-' | replace: '/', '-' | replace: '_', '-' -%}
    {%- assign model_entry = shop.metaobjects.model_number[q_handle_alt] -%}
  {%- endif -%}

  {%- if model_entry != blank -%}
    {%- assign model_products = model_entry.products.value -%}
    {%- if model_products != blank -%}
      {%- for product in model_products -%}
        {%- if results_count >= max_results -%}{%- break -%}{%- endif -%}
        {%- assign pid = product.id | append: '' -%}
        {%- if seen_ids contains pid -%}{%- continue -%}{%- endif -%}
        {%- assign seen_ids = seen_ids | append: pid | append: ',' -%}
        {%- unless first_item -%},{%- endunless -%}
        {%- assign first_item = false -%}
        {%- assign results_count = results_count | plus: 1 -%}
        {%- assign exact_count = exact_count | plus: 1 -%}
        {
          "group": "Model match",
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "meta": {{ model_entry.model.value | default: raw_q | prepend: 'Model ' | json }},
          "image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 120 | json }}{% else %}null{% endif %}
        }
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Fuzzy native search only when no exact metaobject hits {%- endcomment -%}
{%- if exact_count == 0 and search.performed -%}
  {%- for item in search.results -%}
    {%- if results_count >= max_results -%}{%- break -%}{%- endif -%}
    {%- if item.object_type != 'product' -%}{%- continue -%}{%- endif -%}
    {%- assign pid = item.id | append: '' -%}
    {%- if seen_ids contains pid -%}{%- continue -%}{%- endif -%}
    {%- assign seen_ids = seen_ids | append: pid | append: ',' -%}
    {%- unless first_item -%},{%- endunless -%}
    {%- assign first_item = false -%}
    {%- assign results_count = results_count | plus: 1 -%}
    {
      "group": "Products",
      "title": {{ item.title | json }},
      "url": {{ item.url | json }},
      "meta": "Catalog match",
      "image": {% if item.featured_media %}{{ item.featured_media | image_url: width: 120 | json }}{% else %}null{% endif %}
    }
  {%- endfor -%}
{%- endif -%}
]
{%- endcapture -%}

<div data-trs-parts-search-json type="application/json">
  {"query":{{ raw_q | json }},"exact":{{ exact_count }},"results":{{ results_json | strip_newlines }}}
</div>

{% schema %}
{
  "name": "TRS parts search API",
  "settings": []
}
{% endschema %}
